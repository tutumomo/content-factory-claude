# Content Factory 環境變數範本
#
# 使用方式：
#   cp .env.example data/.env && chmod 600 data/.env
#
# 說明：
# - 啟動 ./run.sh 或直接啟動 uvicorn app.main:app 時，會自動讀取 data/.env（或 $CF_DATA/.env）。
# - 優先順序：外部已設定的非空系統環境變數優先於 data/.env，不會被覆蓋；留空欄位會被略過。
# - 本機專屬的 data/.env 位於 data/ 底下（已列入 .gitignore，不會進版控）。

# === LLM 模型（對應設定頁 llm.openai_key_env 等設定） ===
MAGPIE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# === 實拍素材 ===
PEXELS_API_KEY=
PIXABAY_API_KEY=

# === 音效、音樂與雲端配音 ===
FREESOUND_API_KEY=
# Google Gemini API key（Lyria 3 背景音樂與 Gemini TTS 共用）
GEMINI_API_KEY=

# === 伺服器與實例設定（選填） ===
# CF_HOST=127.0.0.1
# CF_PORT=8770
# CF_DATA=
# CF_NSFW=0
